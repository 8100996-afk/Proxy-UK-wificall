[Unit]
Description=Back up Proxy Panel database and encryption keys
After=proxy-panel.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/proxy-panel
EnvironmentFile=/etc/proxy-panel.env
ExecStart=/opt/proxy-panel/venv/bin/python -m proxy_panel.backup
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/proxy-panel /var/lib/proxy-panel

